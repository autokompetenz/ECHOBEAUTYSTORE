generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum Category {
  REMISE_EN_FORME
  INSTRUMENTS_MASSAGE
  PRODUITS_AMAIGRISSANTS
  JOUETS_ADULTES
}

enum PaymentType {
  full
  deposit
  monthly
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  address       String?
  monthlySalary Float?
  role          Role     @default(CLIENT)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders          Order[]
  cartItems       Cart[]
  trackingUpdates OrderTracking[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  price       Float
  stock       Int       @default(1)
  description String?   @db.Text
  category    Category
  subcategory String?
  imageUrl    String?
  imageUrl2   String?
  imageUrl3   String?
  imageUrl4   String?
  imageUrl5   String?
  featured    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  orderItems OrderItem[]
  cartItems  Cart[]
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNumber     String      @unique
  userId          Int?                          // nullable → commandes invités
  customerName    String?                       // invité : nom complet
  customerEmail   String?                       // invité : email
  customerPhone   String?                       // invité : téléphone
  totalPrice      Float
  paymentType     PaymentType
  depositAmount   Float?
  monthlyAmount   Float?
  monthlyDuration Int?
  discountAmount  Float?
  status          OrderStatus @default(pending)
  notes           String?     @db.Text
  shippingAddress String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User?          @relation(fields: [userId], references: [id])
  items    OrderItem[]
  tracking OrderTracking[]
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int   @default(1)
  unitPrice Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderTracking {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  comment   String?     @db.Text
  updatedBy Int?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId],   references: [id], onDelete: Cascade)
  admin User? @relation(fields: [updatedBy], references: [id])
}

model Cart {
  id          Int         @id @default(autoincrement())
  userId      Int
  productId   Int
  quantity    Int         @default(1)
  paymentType PaymentType @default(full)
  createdAt   DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}
