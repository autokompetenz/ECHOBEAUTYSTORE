# Base de données Supabase
# En production Vercel, utiliser le pooler pour DATABASE_URL (port 6543, ?pgbouncer=true)
# et l'URL directe (port 5432) pour DIRECT_URL / migrations.
DATABASE_URL=postgresql://postgres:<PASSWORD>@<PROJECT_REF>.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:<PASSWORD>@<PROJECT_REF>.supabase.co:5432/postgres

# API / uploads images
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Authentification
JWT_SECRET=<CHAINE_ALEATOIRE_64_CARACTERES>
ADMIN_PIN=<CODE_PIN_4_CHIFFRES>

# Emails (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_USER=<EMAIL>
SMTP_PASS=<MOT_DE_PASSE_APP>
FROM_NAME=Echo Beauty Store
FROM_EMAIL=<EMAIL>
APP_URL=https://echobeautystore.vercel.app
