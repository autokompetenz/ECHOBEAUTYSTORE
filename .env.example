# Base de données Neon (PostgreSQL)
# Copier les deux chaînes depuis Neon → Dashboard → Connection Details :
# - DATABASE_URL : endpoint contenant "-pooler" (utilisé par l'API / Vercel)
# - DIRECT_URL   : endpoint sans "-pooler" (Prisma db push / migrations)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<ENDPOINT>-pooler.<REGION>.aws.neon.tech/<DB>?sslmode=require"
DIRECT_URL="postgresql://<USER>:<PASSWORD>@<ENDPOINT>.<REGION>.aws.neon.tech/<DB>?sslmode=require"

# Stockage des images produits (Cloudinary)
# Soit CLOUDINARY_URL seul, soit les trois variables séparées ci-dessous.
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_CLOUD_NAME=<CLOUD_NAME>
CLOUDINARY_API_KEY=<API_KEY>
CLOUDINARY_API_SECRET=<API_SECRET>
# Optionnel : dossier et fichier de mapping pour la migration des images
CLOUDINARY_FOLDER=echobeautystore/products

# Authentification
JWT_SECRET=<CHAINE_ALEATOIRE_64_CARACTERES>
ADMIN_PIN=<CODE_PIN_4_CHIFFRES>

# Emails (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_USER=<EMAIL>
SMTP_PASS=<MOT_DE_PASSE_APP>
FROM_NAME=Echo Beauty Store
FROM_EMAIL=<EMAIL>
APP_URL=https://echobeautystore.vercel.app
